local function isPlayerMoving()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if UserInputService.KeyboardEnabled then
        for _, key in ipairs({Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right}) do
            if UserInputService:IsKeyDown(key) then return true end
        end
    end
    if UserInputService.TouchEnabled then
        if hum.MoveDirection.Magnitude > 0.1 then return true end
    end
    return false
end

table.insert(_G.SB_Connections, RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    if Settings.NoFog then
        Lighting.FogEnd = 9000000000
        Lighting.FogStart = 9000000000
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then atm.Parent = nil end
    end

    if Settings.AimbotCamera then
        local target = getTarget()
        if target then
            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
        end
    end

    updateESP()
    updateDropESP()

    if Settings.SilentAim and Settings.SilentAimLine then
        local target = getTarget()
        local localChar = LocalPlayer.Character
        local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
        if target and localHrp then
            local origin = camera:WorldToViewportPoint(localHrp.Position)
            local dest = camera:WorldToViewportPoint(target.Position)
            silentAimTracerLine.From = Vector2.new(origin.X, origin.Y)
            silentAimTracerLine.To = Vector2.new(dest.X, dest.Y)
            silentAimTracerLine.Visible = true
        else
            silentAimTracerLine.Visible = false
        end
    else
        silentAimTracerLine.Visible = false
    end

    if Settings.SilentAim or Settings.AutoFire then
        local target = getTarget()
        if target then
            shootGun(target)
        elseif Settings.AutoFire then
            local gun = getGun()
            local char = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if gun and char and camera then
                local fireEvent = gun:FindFirstChild("FireEvent")
                local soundEvent = gun:FindFirstChild("WeaponSoundEvent")
                if fireEvent then
                    local origin = gun:FindFirstChild("Handle") and gun.Handle.Position or char.Position
                    local dest = char.Position + camera.CFrame.LookVector * 1000
                    pcall(function() fireEvent:FireServer(origin, camera.CFrame.LookVector) end)
                    if soundEvent then pcall(function() soundEvent:FireServer() end) end
                    drawBulletTracer(origin, dest)
                end
            end
        end
    end
end))

task.spawn(function()
    while true do
        task.wait(0.1)
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                hum.WalkSpeed = Settings.WalkSpeed
                
                -- Arreglo de JumpPower y JumpHeight
                if hum.UseJumpPower then
                    hum.JumpPower = Settings.JumpPower
                else
                    hum.JumpHeight = Settings.JumpPower / 10 -- Conversión aproximada para forzar salto
                end
                
                if Settings.AntiLock then
                    if isPlayerMoving() then
                        hrp.AssemblyLinearVelocity = Vector3.new(math.random(-100, 100), 0, math.random(-100, 100))
                    else
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                end
            end
            -- Arreglo Vehicle Destroyer: Se mueve para todos los lados
            if Settings.VehicleDestroyer and hrp then
                local randomDir = Vector3.new(math.random(-5000, 5000), math.random(-2000, 5000), math.random(-5000, 5000))
                hrp.AssemblyLinearVelocity = randomDir
                hrp.AssemblyAngularVelocity = Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
                hrp.Velocity = randomDir
            end
        end
    end
end)

