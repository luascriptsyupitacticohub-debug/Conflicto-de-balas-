local function drawBulletTracer(origin, destination)
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local p1, vis1 = cam:WorldToViewportPoint(origin)
    local p2, vis2 = cam:WorldToViewportPoint(destination)
    
    if not (vis1 and vis2) then return end
    
    local tracer = Drawing.new("Line")
    tracer.Thickness = 2
    tracer.Color = Color3.fromRGB(0, 255, 0) -- Verde Bala
    tracer.Transparency = 1
    tracer.Visible = true
    tracer.From = Vector2.new(p1.X, p1.Y)
    tracer.To = Vector2.new(p2.X, p2.Y)
    
    task.delay(0.1, function()
        if tracer then
            tracer.Visible = false
            tracer:Remove()
        end
    end)
end

