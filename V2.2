local skeletonLines = {}
local lineCount = 0
local function getSkeletonLine()
    lineCount = lineCount + 1
    if not skeletonLines[lineCount] then
        local l = Drawing.new("Line")
        l.Color = Color3.fromRGB(255, 255, 255)
        l.Thickness = 2
        l.Transparency = 1
        l.Visible = false
        skeletonLines[lineCount] = l
    end
    return skeletonLines[lineCount]
end

local function isHacker(char, hum)
    if not char or not hum then return false end
    if hum.WalkSpeed > 20 then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local vel = hrp.AssemblyLinearVelocity
        if vel.Y > 25 and hum:GetState() ~= Enum.HumanoidStateType.Jumping and hum:GetState() ~= Enum.HumanoidStateType.Freefall then 
            return true 
        end
        if Vector3.new(vel.X, 0, vel.Z).Magnitude > 35 then
            return true
        end
    end
    return false
end

local function updateESP()
    local camera = workspace.CurrentCamera
    if not camera then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Settings.ESPPlayers and player.Character then
                local char = player.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local pos, vis = camera:WorldToViewportPoint(hrp.Position)
                    if vis then
                        local esp = getESP(player)
                        local head = char:FindFirstChild("Head")
                        local topPos = head and (head.Position + Vector3.new(0, 1.6, 0)) or (hrp.Position + Vector3.new(0, 3, 0))
                        local bottomPos = hrp.Position - Vector3.new(0, 3.5, 0)
                        local topScreen = camera:WorldToViewportPoint(topPos)
                        local bottomScreen = camera:WorldToViewportPoint(bottomPos)
                        local height = math.abs(topScreen.Y - bottomScreen.Y)
                        local width = height * 0.65
                        local vector2 = Vector2.new(pos.X - width / 2, topScreen.Y)

                        esp.BoxOutline.Size = Vector2.new(width, height)
                        esp.BoxOutline.Position = vector2
                        esp.BoxOutline.Visible = true
                        esp.Box.Size = Vector2.new(width, height)
                        esp.Box.Position = vector2
                        esp.Box.Visible = true
                        esp.Name.Text = player.DisplayName or player.Name
                        esp.Name.Position = Vector2.new(vector2.X + width / 2, vector2.Y - 22)
                        esp.Name.Visible = true

                        local healthRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local healthBarX = vector2.X - 7
                        local healthBarHeight = height * healthRatio
                        
                        esp.HealthBarBg.Size = Vector2.new(4, height)
                        esp.HealthBarBg.Position = Vector2.new(healthBarX, vector2.Y)
                        esp.HealthBarBg.Visible = true
                        
                        esp.HealthBar.Size = Vector2.new(4, healthBarHeight)
                        esp.HealthBar.Position = Vector2.new(healthBarX, vector2.Y + (height - healthBarHeight))
                        esp.HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthRatio)
                        esp.HealthBar.Visible = true

                        if Settings.ESPScriptUser and isHacker(char, hum) then
                            esp.ScriptTag.Text = "Using Ángel Hub"
                            esp.ScriptTag.Position = Vector2.new(vector2.X + width / 2, vector2.Y - 42)
                            esp.ScriptTag.Visible = true
                            
                            if Settings.LockLineHackers then
                                local localChar = LocalPlayer.Character
                                local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
                                if localHrp then
                                    local origin = camera:WorldToViewportPoint(localHrp.Position)
                                    local dest = camera:WorldToViewportPoint(hrp.Position)
                                    local line = getLockHackerLine(player)
                                    line.From = Vector2.new(origin.X, origin.Y)
                                    line.To = Vector2.new(dest.X, dest.Y)
                                    line.Visible = true
                                end
                            else
                                if lockHackerLines[player] then lockHackerLines[player].Visible = false end
                            end
                        else
                            esp.ScriptTag.Visible = false
                            if lockHackerLines[player] then lockHackerLines[player].Visible = false end
                        end
                    else
                        clearESP(player)
                        if lockHackerLines[player] then lockHackerLines[player].Visible = false end
                    end
                else
                    clearESP(player)
                    if lockHackerLines[player] then lockHackerLines[player].Visible = false end
                end
            else
                clearESP(player)
                if lockHackerLines[player] then lockHackerLines[player].Visible = false end
            end
        end
    end

    for i = 1, lineCount do skeletonLines[i].Visible = false end
    lineCount = 0
    if Settings.ESPSkeleton then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head")
                local ut = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                local lt = char:FindFirstChild("LowerTorso") or ut
                local lua = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                local rua = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                local lul = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                local rul = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

                if head and ut then
                    for _, pair in ipairs({{head, ut}, {ut, lt}, {ut, lua}, {ut, rua}, {lt, lul}, {lt, rul}}) do
                        if pair[1] and pair[2] then
                            local p1, vis1 = camera:WorldToViewportPoint(pair[1].Position)
                            local p2, vis2 = camera:WorldToViewportPoint(pair[2].Position)
                            if vis1 and vis2 then
                                local line = getSkeletonLine()
                                line.From = Vector2.new(p1.X, p1.Y)
                                line.To = Vector2.new(p2.X, p2.Y)
                                line.Visible = true
                            end
                        end
                    end
                end
            end
        end
    end
end

