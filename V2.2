local function getWeaponRarity(toolName)
    local legendary = {"RPG", "M249", "AK47", "Draco"}
    local epic = {"M16", "MP5", "Double Barrel", "Skorpion", "Remington"}
    local rare = {"P226", "Anaconda", "EnergyShot", "Glock", "LongMagGlock"}
    
    if table.find(legendary, toolName) then return RarityColors.Legendary end
