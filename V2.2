-- Loot
local lootQueue = {}
local isLooting = false

local function processLootQueue()
    if isLooting then return end
    isLooting = true
    
    while #lootQueue > 0 do
        local part = table.remove(lootQueue, 1)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if hrp and part and part.Parent then
            local origCF = hrp.CFrame
            pcall(function()
                hrp.CFrame = part.CFrame * CFrame.new(0, 1.5, 0)
                if firetouchinterest then
                    firetouchinterest(hrp, part, 0)
                    task.wait(0.05)
                    firetouchinterest(hrp, part, 1)
                else
                    task.wait(0.1)
                end
            end)
            task.wait(0.1)
        end
    end
    isLooting = false
end

