local function getGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, child in ipairs(char:GetDescendants()) do
        if child.Name == "FireEvent" and child:IsA("RemoteEvent") then
            return child.Parent
        end
    end
    return nil
end

local function getTarget()
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local center = camera.ViewportSize / 2
    local fov = Settings.FOV
    local target = nil
    local char = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not char then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local tPart = player.Character:FindFirstChild(Settings.TargetPart)
            if not tPart then
                tPart = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
            end

            if hum and hum.Health > 0 and tPart and (tPart.Position - char.Position).Magnitude <= Settings.Range then
                local pos, vis = camera:WorldToViewportPoint(tPart.Position)
                if vis and pos.Z > 0 then
                    local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if mag < fov then
                        target = tPart
                        fov = mag
                    end
                end
            end
        end
    end
    return target
end

local function fireWeapon(targetPart)
    if not WeaponEvent or not targetPart then return end
    local char = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local origin = char and char.Position or targetPart.Position
    local dir = (targetPart.Position - origin)
    if dir.Magnitude <= 0.05 then return end
    local unit = dir.Unit
    local shots = Settings.MultiShot and math.max(1, Settings.BulletCount) or 1
    
    drawBulletTracer(origin, targetPart.Position)
    
    for _ = 1, shots do
        pcall(function() WeaponEvent:FireServer("Fire", targetPart, targetPart.Position, unit) end)
        if shots > 1 then task.wait() end
    end
end

local function shootGun(targetPart)
    local gun = getGun()
    if not gun then return end
    local fireEvent = gun:FindFirstChild("FireEvent")
    local soundEvent = gun:FindFirstChild("WeaponSoundEvent")
    if not fireEvent then return end
    local handle = gun:FindFirstChild("Handle")
    local origin = handle and handle.Position or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position)
    if not origin then return end
    local vel = targetPart.AssemblyLinearVelocity or Vector3.new(0,0,0)
    local dir = (targetPart.Position + vel * 0.035 - origin)
    if dir.Magnitude < 0.05 then return end
    
    drawBulletTracer(origin, targetPart.Position + vel * 0.035)
    
    pcall(function() fireEvent:FireServer(origin, dir.Unit) end)
    if soundEvent then pcall(function() soundEvent:FireServer() end) end
end

-- Comprar Items
local function BuyItem(itemName, amount)
    if not SellShopEvent then return end
    amount = amount or 1
    
    for _ = 1, amount do
        pcall(function() SellShopEvent:FireServer("BuyItem", itemName) end)
        pcall(function() SellShopEvent:FireServer("BUY_ITEM", itemName) end)
        pcall(function() SellShopEvent:FireServer("Purchase", itemName) end)
        pcall(function() SellShopEvent:FireServer("Buy", itemName) end)
        pcall(function() SellShopEvent:FireServer(itemName) end)
        pcall(function() SellShopEvent:FireServer("BuyItem", itemName, 1) end)
        task.wait(0.05)
    end
end

-- Fishing / Puddles Logic
local fishingRods = {"FishingRod", "FishingRodPro", "FishingRodUltimate", "Rod"}
local fishTypes = {Bass=true, Coelacanth=true, DolphinFish=true, Marlin=true, NorthernPike=true, Perch=true, SailFish=true, Salmon=true, Tuna=true}

local function findTool(names)
    for _, search in ipairs({LocalPlayer.Character, LocalPlayer.Backpack}) do
        if search then
            for _, name in ipairs(names) do
                local tool = search:FindFirstChild(name)
                if tool and tool:IsA("Tool") then return tool end
            end
        end
    end
end

local function equipFishingRod()
    local rod = findTool(fishingRods)
    if rod and rod.Parent ~= LocalPlayer.Character then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum:EquipTool(rod) end) end
    end
    return rod
end

local function sellItem(tool)
    if not tool or not SellShopEvent then return end
    pcall(function() SellShopEvent:FireServer("SELL_ITEM", "tool", tool) end)
end

local function autoSellFish()
    for _, search in ipairs({LocalPlayer.Character, LocalPlayer.Backpack}) do
        if search then
            for _, child in ipairs(search:GetChildren()) do
                if child:IsA("Tool") and fishTypes[child.Name] then sellItem(child) end
            end
        end
    end
end

