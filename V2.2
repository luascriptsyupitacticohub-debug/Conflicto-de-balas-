-- Auto Farm Charcos (Puddles)
local function startAutoFarmPuddles()
    task.spawn(function()
        if not Settings.AutoFarmPuddles then return end
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local puddles = workspace:FindFirstChild("Interior") and workspace.Interior:FindFirstChild("Puddles") or InteriorPuddles
        
        if puddles then
            local sp = puddles:FindFirstChild("SmallPuddle")
            if sp then hrp.CFrame = sp.CFrame + Vector3.new(0, 3, 0) end
        end
        task.wait(0.5)
        if StartJobResponse then StartJobResponse:FireServer(true) end
        task.wait(1)

        while Settings.AutoFarmPuddles do
            local p = workspace:FindFirstChild("Interior") and workspace.Interior:FindFirstChild("Puddles") or InteriorPuddles
            if p then
                local found = false
                for _, puddle in ipairs(p:GetChildren()) do
                    if not Settings.AutoFarmPuddles then break end
                    if puddle.Name == "SmallPuddle" and puddle:IsA("BasePart") then
                        found = true
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
                        if tool and tool.Parent == LocalPlayer.Backpack and hum then
                            hum:EquipTool(tool)
                        end
                        hrp.CFrame = puddle.CFrame + Vector3.new(0, 2, 0)
                        task.wait(0.3)
                        if CleanPuddleRequest then
                            CleanPuddleRequest:FireServer("Start", puddle)
                            task.wait(5.3)
                            CleanPuddleRequest:FireServer("Complete", puddle)
                        end
                        task.wait(0.5)
                    end
                end
                if not found then task.wait(2) end
            else
                task.wait(2)
            end
        end
    end)
end

