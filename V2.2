-- Billboard para inventario de jugadores
local PlayerBillboards = {}
local function createBillboardForPlayer(player)
    if not player or not player.Character then return end
    local char = player.Character
    local head = char:FindFirstChild("Head")
    if not head then return end

    local tool = char:FindFirstChildOfClass("Tool")
    
    if PlayerBillboards[player] then
        if PlayerBillboards[player].Parent then
            if tool then
                PlayerBillboards[player].TextLabel.Text = "[ " .. tool.Name .. " ]"
                PlayerBillboards[player].TextLabel.TextColor3 = getWeaponRarity(tool.Name)
            else
                PlayerBillboards[player].TextLabel.Text = ""
            end
            return
        end
    end

    if PlayerBillboards[player] then
        PlayerBillboards[player]:Destroy()
        PlayerBillboards[player] = nil
    end

    if not tool then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "InvESP"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local tl = Instance.new("TextLabel")
    tl.Name = "TextLabel"
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.Text = "[ " .. tool.Name .. " ]"
    tl.TextColor3 = getWeaponRarity(tool.Name)
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 14
    tl.Outline = true
    tl.Parent = bb

    PlayerBillboards[player] = bb
end

local function clearAllBillboards()
    for _, gui in pairs(PlayerBillboards) do
        if gui then gui:Destroy() end
    end
    PlayerBillboards = {}
end

-- ESP para armas en el suelo
local DropBillboards = {}
local function getDropPart(drop)
    if drop:IsA("BasePart") then return drop end
    if drop:IsA("Model") then
        if drop.PrimaryPart then return drop.PrimaryPart end
        local handle = drop:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle end
    end
    return drop:FindFirstChildWhichIsA("BasePart", true)
end

local function isWeaponDrop(obj)
    if not obj then return false end
    local name = string.upper(obj.Name)
    if string.sub(name, -5) == "_DROP" then
        local baseName = string.sub(name, 1, #name - 5)
        for _, v in ipairs(weaponNames) do
            if baseName == string.upper(v) then return true end
        end
    end
    return false
end

local function updateDropESP()
    if not Settings.InventoryESP then
        for _, bb in pairs(DropBillboards) do
            if bb then bb:Destroy() end
        end
        DropBillboards = {}
        return
    end

    local detectedDrops = {}
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if isWeaponDrop(descendant) then
            local part = getDropPart(descendant)
            if part then
                detectedDrops[part] = true
                if not DropBillboards[part] or not DropBillboards[part].Parent then
                    if DropBillboards[part] then DropBillboards[part]:Destroy() end
                    
                    local baseName = string.sub(descendant.Name, 1, #descendant.Name - 5)
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "DropESP"
                    bb.Adornee = part
                    bb.Size = UDim2.new(0, 200, 0, 50)
                    bb.StudsOffset = Vector3.new(0, 2, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = part

                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.new(1, 0, 1, 0)
                    tl.BackgroundTransparency = 1
                    tl.Text = "[ " .. baseName .. " ]"
                    tl.TextColor3 = getWeaponRarity(baseName)
                    tl.Font = Enum.Font.GothamBold
                    tl.TextSize = 14
                    tl.Outline = true
                    tl.Parent = bb

                    DropBillboards[part] = bb
                end
            end
        end
    end

    -- Limpiar los billboards de armas que ya no existen
    for part, bb in pairs(DropBillboards) do
        if not detectedDrops[part] or not part.Parent then
            if bb then bb:Destroy() end
            DropBillboards[part] = nil
        end
    end
end

